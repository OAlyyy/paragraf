# Copy to .env and fill in. Never commit .env.

# --- Database ---
# Local Docker Compose default. For Supabase, paste its connection string here.
DATABASE_URL=postgresql://paragraf:paragraf@localhost:5432/paragraf

# --- LLM (used from milestone 5) ---
# One of: groq | openai | anthropic
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
JUDGE_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Embeddings (used from milestone 2) ---
EMBEDDING_MODEL=BAAI/bge-m3

# --- Logging ---
LOG_LEVEL=INFO
